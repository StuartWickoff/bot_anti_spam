# === IA GEMINI ===
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENABLED=true
AI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.85
MIN_REQUEST_INTERVAL=4

# === DATABASE ===
